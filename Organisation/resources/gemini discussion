// SuggestConceptsForLinking queries the Concept Index to find existing concepts semantically related to the new document.
func SuggestConceptsForLinking(newDocEmbedding []float32, topK int) ([]Concept, error) {
	if pineconeClient == nil {
		return nil, fmt.Errorf("pinecone client not initialized")
	}

	index := pineconeClient.Index(ConceptIndexName)

	queryResponse, err := index.Query(context.Background(), &pinecone.QueryRequest{
		Vector:          newDocEmbedding,
		TopK:            uint32(topK),
		IncludeMetadata: true, // Crucial to get the human-readable concept name back
	})
	if err != nil {
		return nil, fmt.Errorf("failed to query concept index: %w", err)
	}

	var suggestedConcepts []Concept
	for _, match := range queryResponse.Matches {
		term, ok := match.Metadata["term"].(string) // Assuming you store the concept string as "term" in metadata
		if !ok {
			log.Printf("Warning: Concept ID %s missing 'term' metadata or not a string.", match.ID)
			term = match.ID // Fallback to ID if term not found
		}
		suggestedConcepts = append(suggestedConcepts, Concept{
			ID:    match.ID,
			Term:  term,
			Score: match.Score,
		})
	}
	return suggestedConcepts, nil
}
