// QueryNetwork searches for relevant documents and concepts based on a user's natural language query.
func QueryNetwork(queryText string, docTopK, conceptTopK int) ([]DocumentMatch, []Concept, error) {
	if pineconeClient == nil {
		return nil, nil, fmt.Errorf("pinecone client not initialized")
	}

	queryEmbedding, err := getEmbedding(queryText)
	if err != nil {
		return nil, nil, fmt.Errorf("failed to get embedding for query: %w", err)
	}

	// 1. Query the Main Information Index
	mainIndex := pineconeClient.Index(MainIndexName)
	docQueryResponse, err := mainIndex.Query(context.Background(), &pinecone.QueryRequest{
		Vector:          queryEmbedding,
		TopK:            uint32(docTopK),
		IncludeMetadata: true, // Get back the stored metadata
	})
	if err != nil {
		return nil, nil, fmt.Errorf("failed to query main documents index: %w", err)
	}

	var docMatches []DocumentMatch
	for _, match := range docQueryResponse.Matches {
		summary, _ := match.Metadata["summary"].(string)
		keyFactsIfc, _ := match.Metadata["key_facts"].([]interface{}) // Need to convert []interface{} to []string
		var keyFacts []string
		for _, f := range keyFactsIfc {
			if s, ok := f.(string); ok {
				keyFacts = append(keyFacts, s)
			}
		}
		linkedConceptsIfc, _ := match.Metadata["associated_concept_ids"].([]interface{})
		var linkedConcepts []string
		for _, c := range linkedConceptsIfc {
			if s, ok := c.(string); ok {
				linkedConcepts = append(linkedConcepts, s)
			}
		}

		docMatches = append(docMatches, DocumentMatch{
			ID:             match.ID,
			Score:          match.Score,
			Summary:        summary,
			KeyFacts:       keyFacts,
			LinkedConcepts: linkedConcepts,
		})
	}

	// 2. Query the Concept Index for related concepts
	conceptIndex := pineconeClient.Index(ConceptIndexName)
	conceptQueryResponse, err := conceptIndex.Query(context.Background(), &pinecone.QueryRequest{
		Vector:          queryEmbedding,
		TopK:            uint32(conceptTopK),
		IncludeMetadata: true,
	})
	if err != nil {
		return nil, nil, fmt.Errorf("failed to query concept index: %w", err)
	}

	var conceptMatches []Concept
	for _, match := range conceptQueryResponse.Matches {
		term, ok := match.Metadata["term"].(string)
		if !ok {
			term = match.ID
		}
		conceptMatches = append(conceptMatches, Concept{
			ID:    match.ID,
			Term:  term,
			Score: match.Score,
		})
	}

	return docMatches, conceptMatches, nil
}
