# ============================================
# MONGODB CONFIGURATION - PRODUCTION
# ============================================
MONGO_INITDB_ROOT_USERNAME=prod_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_production_password_here
MONGO_DB_NAME=esp_organizer_prod
MONGO_AUTH_SOURCE=admin

# Use production MongoDB endpoint (e.g., MongoDB Atlas, managed service)
MONGODB_URI=mongodb+srv://prod_admin:your_secure_production_password_here@your-cluster.mongodb.net/esp_organizer_prod?retryWrites=true&w=majority

# ============================================
# WEAVIATE CONFIGURATION - PRODUCTION
# ============================================
WEAVIATE_URL=http://weaviate:8080

# ============================================
# AWS BEDROCK & S3 CONFIGURATION - PRODUCTION
# ============================================
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_production_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_access_key
AWS_S3_BUCKET=esp-organizer-prod-bucket

# Bedrock models
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_BEDROCK_GENERATIVE_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ============================================
# APPLICATION SETTINGS - PRODUCTION
# ============================================
API_PORT=8080
DEBUG=false
DEBUG_LOG_TO_FILE=true
LOG_LEVEL=info

# ============================================
# SECURITY & DEPLOYMENT
# ============================================
ENVIRONMENT=production
FORCE_REAL_TEXTRACT=true
CLEAR_FIRST=false
MOCK_TEXTRACT=false
MOCK_LLM=false
