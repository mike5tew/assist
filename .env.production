# Server configuration
SERVER_PORT=8080
LOG_LEVEL=info
DEBUG=false

# These credentials are used to initialize the database in Docker.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_DB_NAME=esp_organizer
MONGO_AUTH_SOURCE=admin
# EXTERNAL: For host machine access (e.g., 'make' commands) to the Docker container.
MONGODB_URI_EXTERNAL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@localhost:27017/${MONGO_DB_NAME}?authSource=${MONGO_AUTH_SOURCE}

# INTERNAL: For container-to-container communication (e.g., API service to MongoDB service).
MONGODB_URI_INTERNAL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_DB_NAME}?authSource=${MONGO_AUTH_SOURCE}
# Use production MongoDB endpoint (e.g., MongoDB Atlas, managed service)
MONGODB_URI=mongodb+srv://prod_admin:your_secure_production_password_here@your-cluster.mongodb.net/esp_organizer_prod?retryWrites=true&w=majority


# Weaviate Configuration - internal Docker network
WEAVIATE_URL=http://weaviate:8080

# AWS Configuration - production credentials
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID_REMOVED
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY_REMOVED
AWS_REGION=eu-west-2
AWS_S3_BUCKET=esp-new-organizer-immunology

# AWS Bedrock Configuration - production ready
AWS_BEDROCK_REGION=eu-west-2
AWS_BEDROCK_MODEL=amazon.titan-embed-text-v2:0

# Production settings
CLEAR_FIRST=false
MOCK_TEXTRACT=false

# Production routing configuration
API_BASE_PATH=/esp-organizer-api
FRONTEND_BASE_PATH=/esp-organizer

# Nginx integration
NGINX_PROXY=true
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

EMBEDDING_VECTOR_SIZE=1024







# Bedrock models
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_BEDROCK_GENERATIVE_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ============================================
# APPLICATION SETTINGS - PRODUCTION
# ============================================
API_PORT=8080
DEBUG_LOG_TO_FILE=true
LOG_LEVEL=info

# ============================================
# SECURITY & DEPLOYMENT
# ============================================
ENVIRONMENT=production
FORCE_REAL_TEXTRACT=true
CLEAR_FIRST=false
MOCK_TEXTRACT=false
MOCK_LLM=false
# ==================== DATABASE ====================
# CHANGE THESE BEFORE DEPLOYING!
DB_ROOT_PASSWORD=wuPde4-fuvjev-xixtav
DB_NAME=dare2lead
DB_USER=skills_user
DB_PASSWORD=xiMqun-sezgob-virjo9

# ==================== JWT / SECURITY ====================
# Generate with: openssl rand -base64 32
JWT_SECRET=0LChlKo0oJSSCZAgU9xQ1K7Oz0ejitV6Ax8qzCwe8t4=

# ==================== API ====================
ALLOWED_ORIGIN=http://192.248.151.185

# ==================== FRONTEND ====================
# Behind Nginx proxy - use relative path
REACT_APP_API_URL=/api


# ==================== NODE ====================
NODE_ENV=production