#!/bin/sh

# MongoDB Configuration
# These credentials are used to initialize the database in Docker.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_DB_NAME=esp_organizer
MONGO_AUTH_SOURCE=admin

# --- Connection Strings ---
# EXTERNAL: For host machine access (e.g., 'make' commands) to the Docker container.
MONGODB_URI_EXTERNAL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@localhost:27017/${MONGO_DB_NAME}?authSource=${MONGO_AUTH_SOURCE}

# INTERNAL: For container-to-container communication (e.g., API service to MongoDB service).
MONGODB_URI_INTERNAL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_DB_NAME}?authSource=${MONGO_AUTH_SOURCE}


# Weaviate Configuration
WEAVIATE_URL=http://localhost:8081
WEAVIATE_API_KEY=

# AWS Bedrock/LLM Configuration
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=eu-west-2
AWS_S3_BUCKET=

# Application Settings
SKILLS_COLLECTION=skills
DEBUG_LOG_TO_FILE=true

# --- LLM Provider Configuration ---
# Choose ONE of the following providers and comment out the others.

# Option 1: AWS Bedrock (Recommended for AWS users)
# The model ID must be available in your specified AWS region.
# As of September 2024, 'amazon.titan-embed-text-v1' is not available in many regions.
# Use 'amazon.titan-embed-text-v2:0' for eu-west-2 and other regions.
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_BEDROCK_REGION="eu-west-2"
AWS_BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# Option 2: OpenAI
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Option 3: Ollama (Local LLM)
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="nomic-embed-text"

# --- AWS Textract Configuration (for PDF processing) ---
# These are required if you want to process PDF documents.
# The IAM user for these keys needs Textract and S3 permissions.
AWS_REGION="eu-west-2"
AWS_TEXTRACT_REGION="eu-west-2"
AWS_TEXTRACT_S3_BUCKET="your-s3-bucket-for-textract-processing"
# Note: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from Bedrock section are reused here.