# Server configuration
SERVER_PORT=8080
LOG_LEVEL=info
DEBUG=false

# Database configuration - production MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=production_password_here
MONGODB_URI=mongodb://admin:password123@localhost:27017/esp_organizer?authSource=admin

MONGO_HOST=mongodb
MONGO_USERNAME=admin
MONGO_PASSWORD=production_password_here
MONGO_DB_NAME=esp_project  # optional
MONGO_AUTH_SOURCE=admin    # optional
MONGO_TLS_ENABLED=true     # optional

# Weaviate Configuration - internal Docker network
WEAVIATE_URL=http://weaviate:8080

# AWS Configuration - production credentials
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=eu-west-2
AWS_S3_BUCKET=esp-new-organizer-immunology

# AWS Bedrock Configuration - production ready
AWS_BEDROCK_REGION=eu-west-2
AWS_BEDROCK_MODEL=amazon.titan-embed-text-v2:0

# Production settings
CLEAR_FIRST=false
MOCK_TEXTRACT=false

# JWT Configuration - production secret
JWT_SECRET=your_production_jwt_secret_here

# Production routing configuration
API_BASE_PATH=/esp-organizer-api
FRONTEND_BASE_PATH=/esp-organizer

# Nginx integration
NGINX_PROXY=true
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

EMBEDDING_VECTOR_SIZE=1024