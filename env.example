# =================================================
# UNIFIED PRODUCTION ENVIRONMENT CONFIGURATION
#
# Instructions:
# 1. Copy this file to 'env.production'.
# 2. Fill in ALL secret values below.
# =================================================

# === Skills Map Platform (MySQL Database) ===
# This is the root password for the MySQL container itself.
DB_ROOT_PASSWORD=a_very_secure_mysql_root_password
# These are for the application user that the skills-api will use to connect.
DB_NAME=skills_db
DB_USER=skills_user
DB_PASSWORD=a_very_secure_app_user_password

# === Assist App (MongoDB Database) ===
MONGO_ROOT_USER=your_mongo_user
MONGO_ROOT_PASSWORD=a_very_secure_mongo_password

# === API Security ===
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_real_jwt_secret
# The public IP or domain of your server.
ALLOWED_ORIGIN=http://192.248.151.185
