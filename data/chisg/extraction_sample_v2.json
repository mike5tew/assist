  "extraction_rules": {
    "version": "0.2",
    "principles": [
      {
        "id": "R1",
        "rule": "Named substances in conditions are entities",
        "detail": "If a condition names a specific substance, organism, or mechanism, extract it as a separate semantic unit with its functional role. Do not bury named participants in context metadata."
      },
      {
        "id": "R2",
        "rule": "Replace sequence markers with causal relations",
        "detail": "Convert 'first step', 'leads to', 'then' into explicit causal relations (causes, enables, inhibits). Sequence words are pedagogical scaffolding, not knowledge."
      },
      {
        "id": "R3",
        "rule": "Extract what the source states — nothing more",
        "detail": "The extraction must be a faithful map of the submitted material. Do not inject domain knowledge the source does not contain. If the source says A causes C with no mechanism, extract A→C. Do not insert B."
      },
      {
        "id": "R4",
        "rule": "Granularity is set by the source, not the extractor",
        "detail": "Each source declares its own scope (domain, level, granularity). A GCSE definition that omits a mechanism is complete at GCSE level. Gap detection happens at the graph layer by comparing sources at different declared levels — not during extraction."
      },
      {
        "id": "R5",
        "rule": "Two layers: faithful extraction vs graph-level analysis",
        "detail": "Layer 1 (extraction) maps the source faithfully. Layer 2 (graph analysis) detects gaps, contradictions, and missing mechanisms by comparing across multiple sources. The extractor must never do Layer 2 work."
      },
      {
        "id": "R6",
        "rule": "Definitions are input, not knowledge",
        "detail": "A definition is one author's recorded claim. It is consumed by the extractor to produce links. After extraction, the original text has no ongoing role in the knowledge system. Multiple definitions of the same term from different sources produce overlapping links — that convergence IS the trust score mechanism. Store source text as archive (SQLite/filesystem), not in the knowledge graph."
      },
      {
        "id": "R7",
        "rule": "No 'is defined as' relation",
        "detail": "Definitions do not generate 'is defined as' links. They generate the structural claims embedded within them (causes, is composed of, has value, etc.). A definition that contains only a vocabulary label and no structural claims produces zero links — that is correct, not an error."
      },
      {
        "id": "R8",
        "rule": "Controlled relation vocabulary",
        "detail": "All links must use one of the approved relations. This keeps the graph traversable and queryable.",
        "relations": [
          { "relation": "causes",        "backward": "is caused by",       "use": "Causal chains, produces, leads to" },
          { "relation": "enables",       "backward": "is enabled by",      "use": "Conditions, catalysts, prerequisites" },
          { "relation": "inhibits",      "backward": "is inhibited by",    "use": "Blocks, prevents, reduces" },
          { "relation": "is composed of","backward": "composes",           "use": "Structure, contains, made from" },
          { "relation": "is a type of",  "backward": "includes",           "use": "Classification, taxonomy" },
          { "relation": "has property",  "backward": "is property of",     "use": "Attributes, characteristics, behaviours" },
          { "relation": "has value",     "backward": "is the value of",    "use": "Specific quantities, measurements" },
          { "relation": "is used for",   "backward": "uses",               "use": "Applications, functions, treatments" },
          { "relation": "is found in",   "backward": "contains",           "use": "Location, context, occurrence" },
          { "relation": "is an example of","backward": "has example",      "use": "Instances, specimens" },
          { "relation": "determines",    "backward": "is determined by",   "use": "One thing controls/sets another" },
          { "relation": "represents",    "backward": "is represented by",  "use": "Models, mnemonics, diagrams" },
          { "relation": "contradicts",   "backward": "is contradicted by", "use": "Opposing claims" }
        ]
      }
    ]
  },
